#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8083/'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = db
database.default.database = kkn_tematik
database.default.username = kkn_user
database.default.password = kkn_pass
database.default.DBDriver = MySQLi
# database.default.port     = 3306

#--------------------------------------------------------------------
# EMAIL — Gmail SMTP (OTP & Notifikasi)
# Gunakan "App Password" Gmail, BUKAN password akun Google biasa.
# Cara buat App Password: myaccount.google.com > Keamanan >
# Verifikasi 2 Langkah > Sandi Aplikasi > buat baru, pilih "Mail"
#--------------------------------------------------------------------

email.fromEmail    = claycursor3@gmail.com
email.fromName     = "KKN Tematik UKIM"

email.protocol     = smtp
email.SMTPHost     = smtp.gmail.com
email.SMTPPort     = 465
email.SMTPCrypto   = ssl
email.SMTPUser     = claycursor3@gmail.com
# email.SMTPPass  = xxxx-xxxx-xxxx-xxxx   ← isi App Password Gmail Anda di sini
email.SMTPTimeout  = 10
email.SMTPKeepAlive = false
email.mailType     = html
email.charset      = UTF-8
email.validate     = true

